  - m_Id: 190410071420928
    m_Localized: "T\u1EA1m d\u1EEBng"
    m_Metadata:
      m_Items: []
  - m_Id: 190410071420929
    m_Localized: "Ti\u1EBFp t\u1EE5c"
    m_Metadata:
      m_Items: []
  - m_Id: 190410071420930
    m_Localized: "V\u1EC1 trang ch\u1EE7"
    m_Metadata:
      m_Items: []
  - m_Id: 190410071420931
    m_Localized: "Thu ti\u1EC1n {0}  +{1}"
    m_Metadata:
      m_Items:
      - rid: 4303785569161314328
  - m_Id: 190410071420932
    m_Localized: Bia
    m_Metadata:
      m_Items: []
  - m_Id: 190410071420933
    m_Localized: "M\u1ED3i nh\u1EADu"
    m_Metadata:
      m_Items: []
  - m_Id: 190410071420934
    m_Localized: "N\u01B0\u1EDBc ng\u1ECDt"
    m_Metadata:
      m_Items: []
  - m_Id: 192247772164096
    m_Localized: "C\u1EEDa h\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 192247809912832
    m_Localized: "C\u1EEDa h\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 192247809912833
    m_Localized: "Mua th\xEAm b\xE0n"
    m_Metadata:
      m_Items: []
  - m_Id: 192247809912834
    m_Localized: "Thu\xEA b\u1ED3i b\xE0n"
    m_Metadata:
      m_Items: []
  - m_Id: 192247809912835
    m_Localized: "(\u0110\xE3 c\xF3 {0}/{1} b\xE0n - Gi\xE1 {2})"
    m_Metadata:
      m_Items:
      - rid: 4303785569161314328
  - m_Id: 192247814107136
    m_Localized: "(C\u1EA5p {0}/{1} - Gi\xE1 {2})"
    m_Metadata:
      m_Items:
      - rid: 4303785569161314328
  - m_Id: 192247814107137
    m_Localized: "(\u0110\xE3 t\u1ED1i \u0111a)"
    m_Metadata:
      m_Items: []
  - m_Id: 192247814107138
    m_Localized: Mua
    m_Metadata:
      m_Items: []
  - m_Id: 192247814107139
    m_Localized: "\u0110\xF3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 267664474451968
    m_Localized: "\u0110\u1ED3 n\u01B0\u1EDBng"
    m_Metadata:
      m_Items: []
  - m_Id: 267664524783616
    m_Localized: "M\xF3n m\u1EDBi: {0}"
    m_Metadata:
      m_Items:
      - rid: 4303785569161314328
  - m_Id: 301432564297728
    m_Localized: "\u0110ang m\u1EDF c\u1EEDa"
    m_Metadata:
      m_Items: []
  - m_Id: 301432585269248
    m_Localized: "\u0110\xE3 \u0111\xF3ng c\u1EEDa"
    m_Metadata:
      m_Items: []
  - m_Id: 301432585269249
    m_Localized: "M\u1EDF qu\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 301432585269250
    m_Localized: "\u0110\xF3ng qu\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 306115118837760
    m_Localized: "WASD: \u0111i  \u2022  Chu\u1ED9t: nh\xECn  \u2022  V: \u0111\u1ED5i g\xF3c nh\xECn  \u2022  Tab: hi\u1EC7n chu\u1ED9t  \u2022  O: m\u1EDF/\u0111\xF3ng qu\xE1n  \u2022  B: c\u1EEDa h\xE0ng  \u2022  Esc: t\u1EA1m d\u1EEBng"
    m_Metadata:
      m_Items: []
  - m_Id: 306115148197888
    m_Localized: "K\xE9o b\xEAn tr\xE1i: \u0111i  \u2022  K\xE9o b\xEAn ph\u1EA3i: nh\xECn quanh"
    m_Metadata:
      m_Items: []
  - m_Id: 313960795156480
    m_Localized: "C\xE0i \u0111\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 313960811933696
    m_Localized: "T\xEAn ch\u1EE7 qu\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 313960811933697
    m_Localized: "H\u01B0\u1EDBng d\u1EABn ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 313960811933698
    m_Localized: "Ch\u1EE7 qu\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 313960811933699
    m_Localized: "B\u1ED3i b\xE0n"
    m_Metadata:
      m_Items: []
  - m_Id: 313960811933700
    m_Localized: "H\u01B0\u1EDBng d\u1EABn ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 313960811933701
    m_Localized: "\u0110i\u1EC1u khi\u1EC3n"
    m_Metadata:
      m_Items: []
  - m_Id: 313960811933702
    m_Localized: "M\xE1y t\xEDnh: WASD \u0111\u1EC3 \u0111i, r\xEA chu\u1ED9t \u0111\u1EC3 nh\xECn quanh. B\u1EA5m v\xE0o m\xE0n h\xECnh \u0111\u1EC3 kh\xF3a chu\u1ED9t, Tab \u0111\u1EC3 hi\u1EC7n chu\u1ED9t khi c\u1EA7n b\u1EA5m n\xFAt. \u0110i\u1EC7n tho\u1EA1i: k\xE9o n\u1EEDa tr\xE1i m\xE0n h\xECnh \u0111\u1EC3 \u0111i, k\xE9o n\u1EEDa ph\u1EA3i \u0111\u1EC3 nh\xECn."
    m_Metadata:
      m_Items: []
  - m_Id: 313960811933703
    m_Localized: "M\u1EDF qu\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 313960811933704
    m_Localized: "B\u1EA5m M\u1EDF qu\xE1n (ph\xEDm O) \u0111\u1EC3 b\u1EAFt \u0111\u1EA7u ca. Ng\u01B0\u1EDDi \u0111i \u0111\u01B0\u1EDDng s\u1EBD r\u1EBD v\xE0o qu\xE1n. T\u1EEB 17 gi\u1EDD \u0111\u1EBFn 23 gi\u1EDD kh\xE1ch \u0111\xF4ng nh\u1EA5t, \u0111\xEAm khuya v\u1EAFng kh\xE1ch. \u0110\xF3ng qu\xE1n khi mu\u1ED1n ngh\u1EC9, kh\xE1ch \u0111ang ng\u1ED3i v\u1EABn \u0103n xong r\u1ED3i m\u1EDBi v\u1EC1."
    m_Metadata:
      m_Items: []
  - m_Id: 313960811933705
    m_Localized: "Ph\u1EE5c v\u1EE5 kh\xE1ch"
    m_Metadata:
      m_Items: []
  - m_Id: 313960811933706
    m_Localized: "Kh\xE1ch ng\u1ED3i v\xE0o b\xE0n s\u1EBD hi\u1EC7n bong b\xF3ng h\xECnh m\xF3n h\u1ECD mu\u1ED1n. \u0110i t\u1EDBi g\u1EA7n kh\xE1ch l\xE0 ph\u1EE5c v\u1EE5, m\xF3n s\u1EBD hi\u1EC7n tr\xEAn b\xE0n. Thanh d\u01B0\u1EDBi bong b\xF3ng l\xE0 \u0111\u1ED9 ki\xEAn nh\u1EABn: chuy\u1EC3n \u0111\u1ECF l\xE0 s\u1EAFp b\u1ECF v\u1EC1."
    m_Metadata:
      m_Items: []
  - m_Id: 313960811933707
    m_Localized: "Thu ti\u1EC1n"
    m_Metadata:
      m_Items: []
  - m_Id: 313960811933708
    m_Localized: "\u0102n xong, kh\xE1ch hi\u1EC7n \u0111\u1ED3ng xu v\xE0 ra qu\u1EA7y thu ng\xE2n x\u1EBFp h\xE0ng. \u0110\u1EE9ng l\xEAn v\xF2ng tr\xF2n sau qu\u1EA7y (chuy\u1EC3n xanh) \u0111\u1EC3 thu ti\u1EC1n. Kh\xF4ng ai thu th\xEC kh\xE1ch b\u1ECF \u0111i kh\xF4ng tr\u1EA3 ti\u1EC1n."
    m_Metadata:
      m_Items: []
  - m_Id: 313960811933709
    m_Localized: "C\u1EEDa h\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 313960811933710
    m_Localized: "D\xF9ng ti\u1EC1n trong v\xED qu\xE1n (ph\xEDm B) \u0111\u1EC3 mua th\xEAm b\xE0n v\xE0 thu\xEA b\u1ED3i b\xE0n t\u1EF1 ph\u1EE5c v\u1EE5. M\xF3n m\u1EDBi t\u1EF1 m\u1EDF khi t\u1ED5ng doanh thu \u0111\u1EE7 l\u1EDBn."
    m_Metadata:
      m_Items: []
  - m_Id: 313960811933711
    m_Localized: "G\xF3c nh\xECn"
    m_Metadata:
      m_Items: []
  - m_Id: 313960811933712
    m_Localized: "Ph\xEDm V \u0111\u1ED5i gi\u1EEFa g\xF3c nh\xECn th\u1EE9 nh\u1EA5t v\xE0 g\xF3c nh\xECn sau l\u01B0ng. Esc \u0111\u1EC3 t\u1EA1m d\u1EEBng."
    m_Metadata:
      m_Items: []
