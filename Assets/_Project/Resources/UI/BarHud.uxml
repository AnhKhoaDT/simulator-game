<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/BarGame/BarHud.uss" />
    <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">
        <ui:VisualElement name="top-bar" class="top-bar" picking-mode="Ignore">
            <ui:VisualElement name="stats" class="stats" picking-mode="Ignore">
                <ui:Label name="money" class="hud-stat hud-stat--money" picking-mode="Ignore" />
                <ui:Label name="customers" class="hud-stat" picking-mode="Ignore" />
                <ui:Label name="time" class="hud-stat" picking-mode="Ignore" />
                <ui:Label name="toast" class="hud-toast" picking-mode="Ignore" />
                <ui:Label name="toast-unlock" class="hud-toast hud-toast--unlock" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="actions" class="actions" picking-mode="Ignore">
                <ui:Button name="btn-shop" class="hud-btn" />
                <ui:Button name="btn-pause" class="hud-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="shop-overlay" class="pause-overlay">
            <ui:VisualElement class="pause-panel shop-panel">
                <ui:Label name="shop-title" class="pause-title" />
                <ui:VisualElement class="shop-row">
                    <ui:VisualElement class="shop-heading">
                        <ui:Label name="table-name" class="shop-name" />
                        <ui:Label name="table-info" class="shop-info" />
                        <ui:Label name="table-maxed" class="shop-info" />
                    </ui:VisualElement>
                    <ui:Button name="btn-buy-table" class="hud-btn" />
                </ui:VisualElement>
                <ui:VisualElement class="shop-row">
                    <ui:VisualElement class="shop-heading">
                        <ui:Label name="waiter-name" class="shop-name" />
                        <ui:Label name="waiter-info" class="shop-info" />
                        <ui:Label name="waiter-maxed" class="shop-info" />
                    </ui:VisualElement>
                    <ui:Button name="btn-buy-waiter" class="hud-btn" />
                </ui:VisualElement>
                <ui:Button name="btn-shop-close" class="hud-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="pause-overlay" class="pause-overlay">
            <ui:VisualElement class="pause-panel">
                <ui:Label name="pause-title" class="pause-title" />
                <ui:Button name="btn-resume" class="hud-btn" />
                <ui:Button name="btn-home" class="hud-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
