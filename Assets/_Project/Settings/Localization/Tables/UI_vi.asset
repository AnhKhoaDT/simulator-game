    m_Localized: Startup
    m_Metadata:
      m_Items: []
  - m_Id: 518729730
    m_Localized: "Ch\u1ECDn lo\u1EA1i qu\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 518729731
    m_Localized: "Qu\xE1n Nh\u1EADu"
    m_Metadata:
