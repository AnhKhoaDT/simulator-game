<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/BarGame/BarHud.uss" />
    <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">
        <ui:VisualElement name="top-bar" class="top-bar" picking-mode="Ignore">
            <ui:VisualElement name="stats" class="stats" picking-mode="Ignore">
                <ui:Label name="money" class="hud-stat hud-stat--money" picking-mode="Ignore" />
                <ui:Label name="customers" class="hud-stat" picking-mode="Ignore" />
                <ui:Label name="time" class="hud-stat" picking-mode="Ignore" />
                <ui:Label name="status-open" class="hud-stat hud-status--open" picking-mode="Ignore" />
                <ui:Label name="status-closed" class="hud-stat hud-status--closed" picking-mode="Ignore" />
                <ui:Label name="toast" class="hud-toast" picking-mode="Ignore" />
                <ui:Label name="toast-unlock" class="hud-toast hud-toast--unlock" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="actions" class="actions" picking-mode="Ignore">
                <ui:Button name="btn-open" class="hud-btn hud-btn--open" />
                <ui:Button name="btn-close" class="hud-btn hud-btn--close" />
                <ui:Button name="btn-inventory" class="hud-btn" />
                <ui:Button name="btn-shop" class="hud-btn" />
                <ui:Button name="btn-pause" class="hud-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="crosshair" class="crosshair" picking-mode="Ignore" />
        <ui:VisualElement name="decor-prompt" class="decor-prompt" picking-mode="Ignore">
            <ui:Label name="decor-pick-table" class="decor-chip" picking-mode="Ignore" />
            <ui:Label name="decor-pick-chair" class="decor-chip" picking-mode="Ignore" />
            <ui:Label name="decor-pick-item" class="decor-chip" picking-mode="Ignore" />
            <ui:Label name="decor-pick-seat" class="decor-chip" picking-mode="Ignore" />
            <ui:Label name="decor-pick-waiter" class="decor-chip" picking-mode="Ignore" />
            <ui:Label name="decor-busy" class="decor-chip decor-chip--warn" picking-mode="Ignore" />
            <ui:Label name="decor-carry-table" class="decor-chip" picking-mode="Ignore" />
            <ui:Label name="decor-carry-chair" class="decor-chip" picking-mode="Ignore" />
            <ui:Label name="decor-carry-item" class="decor-chip" picking-mode="Ignore" />
            <ui:Label name="decor-blocked" class="decor-chip decor-chip--warn" picking-mode="Ignore" />
            <ui:Label name="decor-sitting" class="decor-chip" picking-mode="Ignore" />
            <ui:Label name="cashier-give-bill" class="decor-chip decor-chip--cashier" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="hint-bar" class="hint-bar" picking-mode="Ignore">
        </ui:VisualElement>

        <ui:VisualElement name="shop-overlay" class="screen-overlay" />
        <ui:VisualElement name="inventory-overlay" class="screen-overlay" />

        <ui:VisualElement name="payment-overlay" class="pause-overlay">
            <ui:VisualElement class="pay-card">
                <ui:VisualElement class="pay-receipt">
                    <ui:Label name="pay-title" class="receipt-title" />
                    <ui:VisualElement class="receipt-rule" />
                    <ui:VisualElement name="pay-lines" class="receipt-lines" />
                    <ui:VisualElement class="receipt-rule" />
                    <ui:VisualElement class="receipt-line">
                        <ui:Label name="pay-total-label" class="receipt-name receipt-strong" />
                        <ui:Label name="pay-total" class="receipt-amount receipt-strong" />
                    </ui:VisualElement>
                    <ui:VisualElement class="receipt-line">
                        <ui:Label name="pay-cash-label" class="receipt-name" />
                        <ui:Label name="pay-cash" class="receipt-amount" />
                    </ui:VisualElement>
                    <ui:VisualElement class="receipt-line">
                        <ui:Label name="pay-change-label" class="receipt-name" />
                        <ui:Label name="pay-change" class="receipt-amount" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="pay-register">
                    <ui:Label name="pay-register-title" class="pay-register-title" />
                    <ui:Label name="pay-due" class="pay-due" />
                    <ui:Label name="pay-given" class="pay-line" />
                    <ui:Label name="pay-short" class="pay-warn" />
                    <ui:Label name="pay-over" class="pay-warn" />
                    <ui:VisualElement name="pay-notes" class="pay-notes" />
                    <ui:VisualElement class="pay-actions">
                        <ui:Button name="btn-pay-clear" class="hud-btn" />
                        <ui:Button name="btn-pay-confirm" class="hud-btn hud-btn--open pay-confirm" />
                    </ui:VisualElement>
                    <ui:Label name="pay-hint" class="pay-hint" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="pause-overlay" class="pause-overlay">
            <ui:VisualElement class="pause-panel">
                <ui:Label name="pause-title" class="pause-title" />
                <ui:Button name="btn-resume" class="panel-btn panel-btn--primary" />
                <ui:Button name="btn-settings" class="panel-btn" />
                <ui:Button name="btn-home" class="panel-btn panel-btn--secondary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
